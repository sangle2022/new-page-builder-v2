# Page Builder V2 function configuration.
#
# Local development: copy to .env (git-ignored) and fill in.
# Catalyst: set these as function environment variables
#   (Console > Serverless > Functions > new_page_builder_v_2_function > Configuration,
#    or deployment.env_variables in catalyst-config.json, which is git-ignored).
# Never commit real values.

# --- Gemini (required for AI features) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Higher-quality model for full page generation; used only by the pb_ai_job background job
# GEMINI_ADVANCED_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=256
# GEMINI_TIMEOUT_MS=25000   (web requests; jobs allow 240000)
# GEMINI_MAX_OUTPUT_TOKENS=16384
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Reuse a gallery image instead of generating when similarity is at least:
# IMAGE_REUSE_THRESHOLD=0.86   (embedding cosine)
# IMAGE_REUSE_JACCARD=0.6      (keyword overlap fallback)

# Background AI jobs (no 30 s limit): name of a Function job pool running pb_ai_job (see docs/SETUP.md 6b)
AI_JOBPOOL=pbAiJob
# 0 = Gemini "thinking" off on Flash models (fast); -1 = model default
# GEMINI_THINKING_BUDGET=0

# --- Storage (Stratus buckets) ---
PAGES_BUCKET=pb-v2-pages
MEDIA_BUCKET=pb-v2-media

# --- Workflow / roles ---
REQUIRE_APPROVAL=true
# Optional JSON map of Catalyst role name -> app role (admin|marketing|editor|viewer)
# ROLE_MAP={"App Administrator":"admin","Marketing Team Member":"marketing","App User":"editor"}

# --- Security ---
# Random string (32+ characters) used to sign OTP proofs, partial-lead tokens
# and the CRM OAuth state. Changing it invalidates tokens in flight.
APP_SIGNING_SECRET=

# --- Zoho CRM (Server-based Application from https://api-console.zoho.com) ---
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_REDIRECT_URI=https://<your-app-domain>/server/new_page_builder_v_2_function/api/crm/callback
# Use your data centre: accounts.zoho.com / .in / .eu / .com.au / .jp
CRM_ACCOUNTS_URL=https://accounts.zoho.com
CRM_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL
# CRM_MODULE=Leads
# CRM_LEAD_SOURCE=Landing Pages
# CRM_SYNC_TIMEOUT_MS=6000

# --- OTP (dummy | karix) ---
OTP_PROVIDER=dummy
# OTP_DUMMY_CODE=123456
KARIX_ACCESS_KEY=
KARIX_DEPARTMENT_ID=
KARIX_IP_ADDRESS=
# KARIX_BASE_URL=https://auth.instaalerts.zone/otpauthapi
# KARIX_COUNTRY_CODE=91

# --- Misc ---
FUNCTION_NAME=new_page_builder_v_2_function
# Path where the React client is hosted (classic blocks load Bootstrap/Tailwind from here)
CLIENT_BASE=/app
# Default Meta (Facebook) Pixel for published pages; pages can override it
META_PIXEL_ID=
